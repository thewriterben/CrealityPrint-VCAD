{
  "name": "creality-multimaterial-openvcad",
  "version": "1.0.0",
  "description": "Creality MultiMaterial Studio integration for OpenVCAD volumetric designs",
  "main": "openvcad_multimaterial_studio.py",
  "repository": {
    "type": "git",
    "url": "https://github.com/thewriterben/CrealityPrint-KCAD.git"
  },
  "keywords": [
    "creality",
    "3d-printing",
    "multi-material",
    "openvcad",
    "volumetric-design",
    "voxel",
    "functionally-graded",
    "additive-manufacturing"
  ],
  "author": "thewriterben",
  "license": "MIT",
  "dependencies": {
    "python": ">=3.7"
  },
  "features": [
    "OpenVCAD project file support (.vcad, .py, .json)",
